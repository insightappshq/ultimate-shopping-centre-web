# ─── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Postgres (Prisma) ──────────────────────────────────────────────────
# Runtime connection. On Supabase use the pooled "Transaction" URL (port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct/session connection used for migrations (port 5432). Optional elsewhere.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── Supabase Auth ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used by `npm run db:seed` to create the demo auth user.
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token (https://supabase.com/dashboard/account/tokens).
# Only used by `npm run auth:configure` to set up email OTP; not read by the app.
SUPABASE_ACCESS_TOKEN=
# Only for the optional Send Email hook mode (auth:configure -- --mode=hook).
SUPABASE_AUTH_HOOK_SECRET=

# ─── Resend (delivers the 6-digit email OTP for Supabase Auth) ──────────
RESEND_API_KEY=re_...
# Must be on a domain verified in Resend.
EMAIL_FROM="USC <no-reply@your-verified-domain.com>"

# ─── Phone OTP (Twilio Verify, configured in the Supabase dashboard) ────
# Digits in Twilio Verify codes — must match the Verify service's "Code length".
NEXT_PUBLIC_PHONE_OTP_LENGTH=6
# "true" offers "Send code on WhatsApp" (enable the WhatsApp channel on the Verify service first).
NEXT_PUBLIC_PHONE_OTP_WHATSAPP=false
# Test-number code for the demo phone, applied by `npm run auth:configure -- --mode=phone`.
DEMO_USER_PHONE_OTP=123456

# ─── QuickCommerce API ──────────────────────────────────────────────────
QUICKCOMMERCE_API_KEY=
QUICKCOMMERCE_API_BASE_URL=https://api.quickcommerceapi.com
# "true" = sample data (no credits used); "false" = always live.
# Unset = live when QUICKCOMMERCE_API_KEY is present, sample data otherwise.
QUICKCOMMERCE_MOCK=

# ─── Demo account (created by `npm run db:seed`; never shown in the UI) ──
DEMO_USER_EMAIL=demo@usc.app
DEMO_USER_PHONE=+919000000001
DEMO_USER_PASSWORD=Demo@12345

# ─── Legal pages (/terms, /cookies) — set before going live ─────────────
NEXT_PUBLIC_LEGAL_ENTITY_NAME="Ultimate Shopping Centre Pvt. Ltd."
NEXT_PUBLIC_LEGAL_ADDRESS="Registered office address, City, State PIN"
NEXT_PUBLIC_LEGAL_JURISDICTION="the courts at <City>, India"
NEXT_PUBLIC_LEGAL_EMAIL=legal@your-domain.com
NEXT_PUBLIC_GRIEVANCE_OFFICER="Full name"
NEXT_PUBLIC_GRIEVANCE_EMAIL=grievance@your-domain.com
